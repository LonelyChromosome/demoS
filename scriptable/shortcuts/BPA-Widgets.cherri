// Scriptable's actual Shortcuts intent, not a preview or refresh timer claim.
// Intent schema: Open-Jellycore e1ec31c, RefreshAllWidgetsParameter has no fields.
#include 'actions/device'
#define name BPA — Làm mới widget
#define color blue
#define glyph calendar
action 'dk.simonbs.Scriptable.RefreshAllWidgetsIntent' refreshAllWidgets(): text { "ShowWhenRun": false }
const input = getDictionary(ShortcutInput)
const requestIdValue = getValue(input, "requestId")
@requestId = "{requestIdValue}"
const modeValue = getValue(input, "mode")
@mode = "{modeValue}"
if @mode == "probe" {
    @ready = {"status": "BPA_WIDGET_BRIDGE_READY", "requestId": "{@requestId}"}
    @readyText = "{@ready}"
    output(@readyText)
}
refreshAllWidgets()
if @mode == "home" {
    returnToHomescreen()
}
@receipt = {"status": "BPA_WIDGET_REFRESH_REQUESTED", "requestId": "{@requestId}"}
@receiptText = "{@receipt}"
output(@receiptText)
