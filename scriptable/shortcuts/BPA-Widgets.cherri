// Scriptable's actual Shortcuts intent, not a preview or refresh timer claim.
// Intent schema: Open-Jellycore e1ec31c, RefreshAllWidgetsParameter has no fields.
#include 'actions/device'
#define name BPA — Làm mới widget
#define color blue
#define glyph calendar
action 'dk.simonbs.Scriptable.RefreshAllWidgetsIntent' refreshAllWidgets(): text { "ShowWhenRun": false }
action 'dk.simonbs.Scriptable.RunScriptInlineIntent' runWidgetScript(text source: 'script', variable parameter: 'parameter'): text { "runInApp": false, "ShowWhenRun": false }
const input = getDictionary(ShortcutInput)
const requestIdValue = getValue(input, "requestId")
@requestId = "{requestIdValue}"
const modeValue = getValue(input, "mode")
@mode = "{modeValue}"
if @mode == "probe" {
    @ready = {"status": "BPA_WIDGET_BRIDGE_READY", "protocol": 2, "requestId": "{@requestId}"}
    @readyText = "{@ready}"
    output(@readyText)
}
@widgetCode = "const fm=FileManager.local();\nconst path=fm.joinPath(fm.documentsDirectory(),\"BPA — WidgetEngine.js\");\nif(!fm.fileExists(path))throw new Error(\"Chưa chuẩn bị BPA.\");\nconst localModule=Object.create(null);localModule.exports=Object.create(null);localModule.filename=path;\nnew Function(\"module\",fm.readString(path))(localModule);\nconst result=await localModule.exports.widgetCommand(args.shortcutParameter);\nScript.setShortcutOutput(JSON.stringify(result));\nScript.complete();"
if @mode != "refresh" {
    runWidgetScript(@widgetCode, input)
}
refreshAllWidgets()
if @mode == "home" {
    returnToHomescreen()
}
@receipt = {"status": "BPA_WIDGET_REFRESH_REQUESTED", "requestId": "{@requestId}"}
@receiptText = "{@receipt}"
output(@receiptText)
